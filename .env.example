# Root environment template for docker compose. Copy to .env and adjust.
# All values have working defaults — docker compose up works without an .env.

# --- PostgreSQL ---
POSTGRES_DB=leetcode_tracker
POSTGRES_USER=leetcode_tracker
POSTGRES_PASSWORD=leetcode_tracker
POSTGRES_PORT=5432

# --- Backend (Spring Boot) ---
BACKEND_PORT=8080
# App fails to start if migrations cannot be applied — keep true.
APP_FLYWAY_ENABLED=true
# Allowed CORS origins; frontend served by nginx on FRONTEND_PORT.
APP_CORS_ORIGINS=http://localhost:80

# --- Frontend (nginx) ---
FRONTEND_PORT=80

# --- Optional Maildev profile (docker compose --profile mail up) ---
MAILDEV_WEB_PORT=1080
MAILDEV_SMTP_PORT=1025

# --- Backend .env for local (non-docker) development, see backend/.env.example ---
# APP_DB_URL=jdbc:postgresql://localhost:5432/leetcode_tracker
# APP_DB_USERNAME=leetcode_tracker
# APP_DB_PASSWORD=leetcode_tracker
# APP_SERVER_PORT=8080
# APP_CORS_ORIGINS=http://localhost:5173
