# Base URL of the backend API. Defaults to "/api" (served by the same origin;
# in `npm run dev` Vite proxies /api to the backend, see vite.config.ts).
VITE_API_URL=/api

# Backend origin for the Vite dev proxy (only used by `npm run dev`).
# VITE_API_PROXY_TARGET=http://localhost:8080

# Test-account fixtures used by the Vitest auth suites.
VITE_AUTH_TEST_ENABLED=true
VITE_AUTH_TEST_EMAIL=qa@leetcode.local
VITE_AUTH_TEST_PASSWORD=123456
VITE_AUTH_TEST_CODE=123456
