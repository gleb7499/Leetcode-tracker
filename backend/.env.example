# Backend environment template. Copy to .env and adjust for local development.

# PostgreSQL datasource
APP_DB_URL=jdbc:postgresql://localhost:5432/leetcode_tracker
APP_DB_USERNAME=leetcode_tracker
APP_DB_PASSWORD=leetcode_tracker

# Flyway is off until the first migration is added (stage 1+). Set to true when migrations exist.
APP_FLYWAY_ENABLED=false

# Server port
APP_SERVER_PORT=8080

# Comma-separated allowed CORS origins (Vite dev server by default)
APP_CORS_ORIGINS=http://localhost:5173
