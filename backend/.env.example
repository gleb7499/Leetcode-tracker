# Backend environment template. Copy to .env and adjust for local development.

# PostgreSQL datasource
APP_DB_URL=jdbc:postgresql://localhost:5432/leetcode_tracker
APP_DB_USERNAME=leetcode_tracker
APP_DB_PASSWORD=leetcode_tracker

# Flyway owns the schema (migrations in db/migration). Enabled by default;
# the application fails to start if migrations cannot be applied.
APP_FLYWAY_ENABLED=true

# Server port
APP_SERVER_PORT=8080

# Comma-separated allowed CORS origins (Vite dev server by default)
APP_CORS_ORIGINS=http://localhost:5173

# --- Auth (JWT) ---
# Secret for signing access tokens. The dev default below is for local
# development ONLY — override it in any real deployment.
APP_JWT_SECRET=local-dev-only-jwt-secret-change-me-0123456789abcdef
# Access token TTL in seconds (default 15 min)
APP_JWT_ACCESS_TTL_SECONDS=900
# Refresh token TTL in days (default 30)
APP_JWT_REFRESH_TTL_DAYS=30

# --- Email ---
# If APP_MAIL_HOST is set, OTP emails are sent via SMTP (e.g. Maildev on
# localhost:1025, or a real relay). If it is empty, the dev fallback kicks in
# and OTP codes are written to the application log instead.
APP_MAIL_HOST=
APP_MAIL_PORT=587
APP_MAIL_USERNAME=
APP_MAIL_PASSWORD=
APP_MAIL_FROM=leetcode-tracker@localhost
